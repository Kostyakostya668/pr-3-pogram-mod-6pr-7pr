<Page x:Class="pr_3_pogram_mod.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr_3_pogram_mod.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Client" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="textName" Grid.Row="0" Margin="5, 5, 400, 5" TextAlignment="Left"/>

        <StackPanel x:Name="spUserOn" Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Информация о заявках для УК:" VerticalAlignment="Center"/>
            <Button x:Name="btPrintInfo" Content="Данные в PDF" Click="btPrintInfo_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
