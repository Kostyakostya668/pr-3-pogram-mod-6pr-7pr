<Window x:Class="pr_3_pogram_mod.Pages.DocPage.DocPdfInfoRes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_3_pogram_mod.Pages.DocPage"
        mc:Ignorable="d"
        Title="DocPdfInfoRes" Height="450" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <FlowDocumentScrollViewer x:Name="flowDoc">
                <FlowDocument ColumnWidth="Infinity" PagePadding="2cm" >
                    
                    <Paragraph>
                        <Run Text="{Binding Resident.name}"/>
                        <Run Text="{Binding Resident.surname}"/>
                    </Paragraph>

                    <Table x:Name="RequestsTable">
                        <Table.Columns>
                            <TableColumn Width="2*"/>
                            <TableColumn Width="2*"/>
                            <TableColumn Width="2*"/>
                            <TableColumn Width="2*"/>
                            <TableColumn Width="2*"/>
                            <TableColumn Width="2*"/>
                        </Table.Columns>
                        <TableRowGroup FontSize="14">
                            <TableRow FontSize="15" Background="LightGray">
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Описание</Paragraph>
                                </TableCell>
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Работник</Paragraph>
                                </TableCell>
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Статус</Paragraph>
                                </TableCell>
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Дата создания</Paragraph>
                                </TableCell>
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Дата назначения</Paragraph>
                                </TableCell>
                                <TableCell BorderThickness="1" BorderBrush="Black" Padding="5">
                                    <Paragraph>Дата выполнения</Paragraph>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>

                </FlowDocument>
            </FlowDocumentScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="spBtns">
            <Button x:Name="btInPdf" Content="В Pdf" HorizontalAlignment="Left" Margin="5,10" Click="btInPdf_Click"/>
        </StackPanel>

    </Grid>
</Window>
